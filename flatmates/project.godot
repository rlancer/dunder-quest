; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flatmates.js"
config/version="1.0.0"
config/description="Flatmates.js: a Dunder Quest game. Two flatmates, two points of view, and the JavaScript one of them runs."
run/main_scene="res://ui/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Controls="*res://core/controls.gd"
Progress="*res://core/progress.gd"
MusicDirector="*res://core/music_director.gd"
TouchControls="*res://core/touch_controls.gd"

[audio]

buses/default_bus_layout="res://core/default_bus_layout.tres"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://ui/theme.tres"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="flatmates"
2d_physics/layer_3="props"

[physics]

2d/default_gravity=1400.0

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.1, 0.13, 1)
