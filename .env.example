# Copy to .env and paste your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Leave this unless you are using a proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# For voice-over (Prince of Versions' prologue: games/prince/tools/voice.py).
# Paste your key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
