# Copy to .env and paste your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Leave this unless you are using a proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Set to grok to generate images through the Grok CLI (`grok login`, no key needed).
# IMAGE_PROVIDER=grok
