      "opening": [
        "The Vizier is waiting behind his gate.",
        "\"One lever opens it. The other bars it. And you have one life, little prince.\""
      ],
      "card": {
        "title": "A conflict is Git asking you",
        "code": [
          "<<<<<<< HEAD",
          "open",
          "=======",
          "barred",
          ">>>>>>> winch",
          "git add gate                      # after you've fixed the file",
          "git commit                        # finish the merge",
          "git merge --abort                 # or call the whole merge off"
        ],
        "insight": "Git merges whatever only one side changed (the drawbridge). When both sides changed the same line, it writes both into the file between markers and stops. HEAD's side is the branch you're on; the other is the one you're merging in. Edit the file to what you want, add it, commit."
      },
      "solution": [
        ["switch_c", "tower"],
        ["set", "gate", "open"],
        ["commit"],
        ["switch", "main"],
        ["switch_c", "winch"],
        ["set", "bridge", "down"],
        ["set", "gate", "barred"],
        ["commit"],
        ["switch", "main"],
        ["merge", "tower"],
        ["merge", "winch", {"fails":true}],
        ["resolve", "gate", "theirs"],
        ["commit_merge"],
        ["reset", "ORIG_HEAD"],
        ["merge", "winch", {"fails":true}],
        ["resolve", "gate", "ours"],
        ["commit_merge"]
      ]
