      "signs": {
        "1": "The palace guard lets no one commit straight onto main. Open a new timeline first: git switch -c.",
        "2": "No way back up. But main is still where you left it: git switch main."
      },
      "opening": [
        "Two ways down, and a guard on the main line."
      ],
      "card": {
        "title": "Branches are parallel timelines",
        "code": [
          "git switch -c left                # a new branch, and step onto it",
          "git switch main                   # back to main: the files change with you",
          "git merge left                    # bring left's commits into main",
          "# older spelling: git checkout -b left, git checkout main"
        ],
        "insight": "A branch is a name on a commit. Try something on a branch and main never knows. If main hasn't moved, merging just slides main forward to the branch (a fast-forward). Uncommitted changes follow you between branches unless the switch would overwrite them."
      },
      "solution": [
        ["set", "gate", "open"],
        ["commit", {"fails":true}],
        ["switch_c", "left"],
        ["commit"],
        ["switch", "main"],
        ["switch_c", "right"],
        ["set", "gate", "open"],
        ["set", "spikes", "armed"],
        ["commit"],
        ["switch", "main"],
        ["merge", "right"],
        ["reset", "ORIG_HEAD"],
        ["merge", "left"]
      ]
