{
  "cast": {
    "prince": {"full": "The Prince", "role": "nimble, brave, and carrying a dagger full of sand"},
    "vizier": {"full": "Grand Vizier Rebasir", "role": "the villain, who commits sabotage and means to rewrite history"},
    "princess": {"full": "Princess Shirin", "role": "locked in the tower, keeping the palace ledger"}
  },
  "guard_hook": [
    "#!/bin/sh",
    "# The palace guard: nothing is committed straight onto main, except a merge.",
    "branch=$(git symbolic-ref --short HEAD)",
    "if [ \"$branch\" = main ] && [ ! -f \"$(git rev-parse --git-dir)/MERGE_HEAD\" ]; then",
    "  echo \"The palace guard: no commits straight onto main. Make a branch (git switch -c).\" >&2",
    "  exit 1",
    "fi"
  ],
  "levels": [
    {
      "id": 1,
      "slug": "hall-of-seals",
      "title": "The Hall of Seals",
      "git": "git commit · git reset --hard HEAD",
      "backdrop": "hall",
      "music": "room",
      "time": 300,
      "unlock": ["commit", "reset"],
      "branches": [],
      "files": {"torch_1": "dark", "torch_2": "dark", "torch_3": "dark"},
      "messages": {
        "torch_1": {"lit": "Light the first torch"},
        "torch_2": {"lit": "Light the second torch"},
        "torch_3": {"lit": "Light the third torch"}
      },
      "exit_when": {"torch_1": "lit", "torch_2": "lit", "torch_3": "lit"},
      "map": [
        "##############################",
        "##############################",
        "#............................#",
        "#............................#",
        "#............................#",
        "#............................#",
        "#............................#",
        "#............................#",
        "#............................#",
        "#............................#",
        "#............................#",
        "#............................#",
        "#...............b............#",
        "#...1.a.......######....c.2..#",
        "#.P...........######........E#",
        "#########^^#########^^^#######",
        "##############################"
      ],
      "legend": {
        "a": {"type": "torch", "file": "torch_1"},
        "b": {"type": "torch", "file": "torch_2"},
        "c": {"type": "torch", "file": "torch_3"}
      },
      "signs": {
        "1": "The Dagger of HEAD turns back the sands, but only to a moment you sealed. Light a torch, then draw the dagger and commit.",
        "2": "The door opens only for sealed history. Commit the last torch."
      },
      "opening": [
        "The Vizier has locked the Princess in the tower and turned the hourglass.",
        "All you have is a dagger full of sand."
      ],
      "card": {
        "title": "A commit is a save point",
        "code": [
          "git status                        # what changed since the last commit",
          "git commit -am \"Light the first torch\"",
          "git reset --hard HEAD             # throw away everything since"
        ],
        "insight": "A commit is a snapshot of every tracked file. reset --hard puts them all back, and whatever you hadn't committed is gone for good. (-a stages files Git already tracks; a brand-new file needs git add first.)"
      },
      "solution": [
        ["set", "torch_1", "lit"],
        ["commit"],
        ["set", "torch_2", "lit"],
        ["die"],
        ["reset", "HEAD"],
        ["set", "torch_2", "lit"],
        ["commit"],
        ["set", "torch_3", "lit"],
        ["commit"]
      ]
    },
