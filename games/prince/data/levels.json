      "signs": {
        "1": "Step on the plate to lower the bridge, then seal it. A commit saves every file in the room.",
        "2": "The log lists every seal, newest first. HEAD is the newest, whoever made it."
      },
      "triggers": [
        {
          "col": 15,
          "who": "vizier",
          "say": [
            "Sealing moments, little prince? So can I.",
            "git commit -am \"Arm the spikes and bar the door\""
          ],
          "steps": [
            ["set", "spikes", "armed"],
            ["set", "door", "barred"],
            ["commit", {"message":"Arm the spikes and bar the door", "author":"vizier"}]
          ]
        }
      ],
      "opening": [
        "Down in the dungeons: a bridge, and a long walk to the door."
      ],
      "card": {
        "title": "Go back further than HEAD",
        "code": [
          "git log --oneline                 # every commit, newest first",
          "git reset --hard HEAD~1           # the commit before HEAD",
          "git reset --hard 3f2a1c9          # or any commit, by its id"
        ],
        "insight": "HEAD is the newest commit on your branch, whoever made it. Resetting to an older commit drops every commit after it from the branch. commit -am takes every changed file, so the Vizier's commit swept up anything you hadn't sealed."
      },
      "solution": [
        ["set", "bridge", "down"],
        ["commit"],
        ["trigger",0],
        ["reset", "HEAD"],
        ["reset", "msg:Lower the bridge"]
      ]
