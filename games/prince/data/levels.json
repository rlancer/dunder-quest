      },
      "signs": {
        "1": "This room has a past. Draw the dagger and read the log: the Vizier barred the door, then the Princess lowered the bridge.",
        "2": "A reset throws away every commit after it. A revert adds a new commit that undoes just one."
      },
      "opening": [
        "Someone has been here before you. Two someones."
      ],
      "card": {
        "title": "Undo one commit, keep the rest",
        "code": [
          "git revert 3f2a1c9                # a new commit that undoes that one",
          "git reset --hard ORIG_HEAD        # undo the reset you just regretted"
        ],
        "insight": "revert doesn't remove anything from history: it adds a commit that does the opposite, so every later commit stays. It's the safe undo on a branch other people share. ORIG_HEAD is where HEAD was before your last reset or merge."
      },
      "solution": [
        ["reset", "msg:The room as you found it"],
        ["reset", "ORIG_HEAD"],
        ["set", "portcullis", "open"],
        ["revert", "msg:Bar the door"],
        ["commit"]
      ]
