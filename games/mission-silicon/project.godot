; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mission Silicon"
config/version="0.1.0"
config/description="Mission Silicon: a Dunder Quest game. You're a non-technical founder launching an AI startup, and your AI coding assistant is very sure of itself."
run/main_scene="res://ui/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Progress="*res://core/progress.gd"
Sideways="*res://ui/sideways.gd"
Sound="*res://core/sound.gd"

[audio]

buses/default_bus_layout="res://core/default_bus_layout.tres"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.96, 0.96, 0.94, 1)
