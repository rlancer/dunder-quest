; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="A Game About Nothing"
config/version="0.1.0"
config/description="A Game About Nothing: a Dunder Quest game. Four friends, one coffee shop, and five counters in New York that run on rules: make every request from cards. Learn HTTP and REST APIs."
run/main_scene="res://ui/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Social="*res://core/social.gd"
Controls="*res://core/controls.gd"
Progress="*res://core/progress.gd"
MusicDirector="*res://core/music_director.gd"
TouchControls="*res://core/touch_controls.gd"

[audio]

buses/default_bus_layout="res://core/default_bus_layout.tres"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://ui/theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.05, 0.1, 1)
