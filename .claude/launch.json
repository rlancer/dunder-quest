{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "exec",
        "--",
        "python",
        "-m",
        "http.server",
        "8123",
        "--directory",
        "build/site"
      ],
      "port": 8123
