{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "exec",
        "--",
        "python",
        "-m",
        "http.server",
        "8123",
        "--directory",
        "build/site"
      ],
      "port": 8123
    },
    {
      "name": "social",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["deploy/dev.ts", "--port", "8788"],
      "port": 8788
    }
  ]
}
