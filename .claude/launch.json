        "--port",
        "5182",
        "--strictPort"
      ],
      "port": 5182
    },
    {
      "name": "mission-silicon-ways",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "games/mission-silicon/ways",
