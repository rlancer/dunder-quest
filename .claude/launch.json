{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "exec",
        "--",
        "python",
        "-m",
        "http.server",
        "8123",
        "--directory",
        "build/site"
      ],
      "port": 8123
    },
    {
      "name": "mission-silicon-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "games/mission-silicon/web",
        "dev",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "mission-silicon-lab",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "games/mission-silicon/lab",
        "dev",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    }
  ]
}
