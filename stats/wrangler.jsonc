// The admin area (dunderquest.com/admin) and the endpoint the game reports to
// (stats.dunderquest.com/api/events). Cloudflare Access guards both hosts
// except /api/events; see README.md. The ember-trail.robertlancer.com hosts
// are from before the rename: builds already out there still report to them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ember-trail-stats",
  "account_id": "3315bb3e7d2e3556bfea6fb3947a890e",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  // Only the custom domain, which Access guards; no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "stats.dunderquest.com", "custom_domain": true },
    { "pattern": "stats.ember-trail.robertlancer.com", "custom_domain": true },
    // Path routes win over the game site's custom domain, so /admin lands here.
    { "pattern": "dunderquest.com/admin", "zone_name": "dunderquest.com" },
    { "pattern": "dunderquest.com/admin/*", "zone_name": "dunderquest.com" }
  ],
  // The Vite plugin fills in the directory; the binding lets the Worker serve
  // the build under /admin.
  "assets": { "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ember-trail-stats",
      // Replace with the id `wrangler d1 create ember-trail-stats` prints.
      "database_id": "da5fc032-958f-418a-a872-9eb1f223b2fa",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "EVENT_LIMITER", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Where the game is served from, for CORS on /api/events.
    "GAME_ORIGINS": "https://dunderquest.com,https://www.dunderquest.com,https://dev.dunderquest.com,https://ember-trail.robertlancer.com",
    // Your Zero Trust team domain and the Access application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "single-phase-capital-web-pages.cloudflareaccess.com",
    "ACCESS_AUD": "d9c9c74e20fa130322c1cad17feec13190c33a2bf309f573e134514ca4fc2471",
    "ALLOWED_EMAILS": "robert.lancer@gmail.com"
  }
}
